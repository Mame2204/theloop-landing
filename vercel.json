{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/confidentialite", "destination": "/privacy", "permanent": true },
    { "source": "/politique-de-confidentialite", "destination": "/privacy", "permanent": true },
    { "source": "/politique-confidentialite", "destination": "/privacy", "permanent": true },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    { "source": "/conditions", "destination": "/cgu", "permanent": true },
    { "source": "/terms", "destination": "/cgu", "permanent": true },
    { "source": "/terms-of-service", "destination": "/cgu", "permanent": true },
    { "source": "/mentions-legales", "destination": "/mentions", "permanent": true },
    { "source": "/delete-account", "destination": "/suppression", "permanent": true },
    { "source": "/account-deletion", "destination": "/suppression", "permanent": true },
    { "source": "/theloop-pass", "destination": "/pass", "permanent": true },
    { "source": "/espace-pro", "destination": "/pass", "permanent": true }
  ]
}
